# Copier en .env.local UNIQUEMENT pour le développement (npx expo start).
# L'APK n'en a pas besoin : eas.json fixe déjà EXPO_PUBLIC_API_URL pour chaque build.
# Ne mettez jamais de clé secrète ici : tout ce qui commence par EXPO_PUBLIC_ est lisible dans l'application.
EXPO_PUBLIC_API_URL=https://easevent.nitypulse.com
