{
  "expo": {
    "name": "Easevent",
    "slug": "easevent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eranis.easevent",
      "associatedDomains": [
        "applinks:easevent.nitypulse.com"
      ],
      "infoPlist": {
        "NSContactsUsageDescription": "Easevent accède à vos contacts uniquement quand vous choisissez qui inviter. Seuls les contacts sélectionnés sont envoyés."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B6B4A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.eranis.easevent",
      "permissions": [
        "android.permission.READ_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "easevent.nitypulse.com",
              "pathPrefix": "/i/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Easevent",
      "shortName": "Easevent",
      "lang": "fr",
      "themeColor": "#1B6B4A",
      "backgroundColor": "#FFFFFF",
      "description": "Easevent — créez l'exceptionnel. Organisez vos événements, invitez, gérez vos tickets."
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Easevent accède à vos contacts uniquement quand vous choisissez qui inviter. Seuls les contacts sélectionnés sont envoyés."
        }
      ]
    ],
    "scheme": "easevent"
  }
}