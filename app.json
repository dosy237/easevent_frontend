{
  "expo": {
    "name": "Easevent",
    "slug": "easevent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eranis.easevent",
      "associatedDomains": [
        "applinks:easevent.nitypulse.com"
      ],
      "infoPlist": {
        "NSContactsUsageDescription": "Easevent accède à vos contacts uniquement quand vous choisissez qui inviter. Seuls les contacts sélectionnés sont envoyés.",
        "NSCameraUsageDescription": "Easevent utilise l'appareil photo pour scanner les tickets à l'entrée de vos événements et pour envoyer des photos.",
        "NSPhotoLibraryUsageDescription": "Easevent accède à vos photos uniquement quand vous choisissez une image à envoyer ou une couverture d'événement.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B6B4A",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.eranis.easevent",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "easevent.nitypulse.com",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "easevent.nitypulse.com",
              "pathPrefix": "/e/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Easevent",
      "shortName": "Easevent",
      "lang": "fr",
      "themeColor": "#1B6B4A",
      "backgroundColor": "#FFFFFF",
      "description": "Easevent — créez l'exceptionnel. Organisez vos événements, invitez, gérez vos tickets."
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Easevent accède à vos contacts uniquement quand vous choisissez qui inviter. Seuls les contacts sélectionnés sont envoyés."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1B6B4A",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Easevent utilise l'appareil photo pour scanner les tickets à l'entrée de vos événements.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Easevent accède à vos photos uniquement quand vous choisissez une image à envoyer ou une couverture d'événement.",
          "cameraPermission": "Easevent utilise l'appareil photo pour prendre une photo à envoyer.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "easevent",
    "description": "Easevent — créez l'exceptionnel. Organisez vos événements, invitez vos proches, gérez vos tickets."
  }
}
